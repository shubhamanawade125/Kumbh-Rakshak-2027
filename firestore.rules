rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access: authenticated users can manage their own profile; public read for command lookup
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Emergency incidents and timeline logs
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    // Missing person alerts & reunifications
    match /missing_persons/{personId} {
      allow read, write: if true;
    }

    // Emergency services fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
